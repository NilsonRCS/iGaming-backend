# ── PostgreSQL ─────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=igaming
POSTGRES_USER=igaming
POSTGRES_PASSWORD=igaming

# ── LocalStack / SQS ───────────────────────────────
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-processor
SQS_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo

# ── App ────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
