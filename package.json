{
  "name": "igaming-backend",
  "version": "1.0.0",
  "description": "Jungle Gaming — Distributed Wagering Processor",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --env-file-if-exists=.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start:debug": "nest start --debug --watch --exec \"node --env-file-if-exists=.env\"",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration",
    "test:watch": "bun test --watch",
    "test:load": "bun run test/load/run.ts",
    "migration:create": "bun --bun node_modules/.bin/mikro-orm migration:create",
    "migration:up": "bun --bun node_modules/.bin/mikro-orm migration:up",
    "migration:down": "bun --bun node_modules/.bin/mikro-orm migration:down",
    "migration:list": "bun --bun node_modules/.bin/mikro-orm migration:list"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.600.0",
    "@mikro-orm/cli": "^6.3.0",
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/terminus": "^10.2.3",
    "decimal.js": "^10.4.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^20.14.0",
    "@types/bun": "latest",
    "typescript": "~5.4.5"
  }
}
